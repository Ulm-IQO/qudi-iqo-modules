             # NI counter returns CUMULATIVE edge counts per sample clock tick
             raw = np.asarray(
                 self._daq_task.read(
                     number_of_samples_per_channel=n_pixels, timeout=120.0),
                 dtype=float,
             )
             self._daq_task.stop()
             self._daq_task.close()
             self._daq_task = None
             # Differentiate to get counts *per* pixel
             counts = np.diff(np.concatenate([[0.0], raw]))
             return counts
         except Exception as exc:
             self.log.error(f'NI-DAQ read error: {exc}')
             return None
