             if time.monotonic() - t0 > timeout_s:
                 self.log.error('Time Tagger: data not ready after timeout.')
                 return None
             time.sleep(0.05)
         data = self._tt_meas.getData().ravel().astype(float)
         return data
        ════════════════════════════════════════════════════════════════════
        """
        # ── INSERT YOUR COUNTER READ CODE HERE ────────────────────────────
        self.log.debug(
