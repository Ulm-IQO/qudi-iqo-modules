"""

import ctypes
import threading
import time
from typing import Dict, List, Optional, Tuple

import numpy as np

from qudi.core.configoption import ConfigOption
from qudi.util.constraints import ScalarConstraint

from qudi.interface.scanning_probe_interface import (
    BackScanCapability,
    ScanConstraints,
    ScanData,
    ScannerAxis,
    ScannerChannel,
    ScanSettings,
    ScanningProbeInterface,
)

# ── PI controller import ───────────────────────────────────────────────────────
# Place pie710_controller.py alongside this file in the same hardware directory,
# OR adjust the import path to match your installation.
try:
    from .pie710_controller import PIE710Controller, PIE7XXError
except ImportError:
    # Fallback for stand-alone development / testing
    from pie710_controller import PIE710Controller, PIE7XXError
# ──────────────────────────────────────────────────────────────────────────────


class PIE710ScanningProbe(ScanningProbeInterface):
    """
    Qudi ScanningProbeInterface for the PI E-710 3CD piezo scanner.

    Axis mapping
    ────────────
        'x'  →  PI physical axis 1   (fast axis in XY and XZ scans)
        'y'  →  PI physical axis 2   (slow axis in XY; fast axis in YZ)
        'z'  →  PI physical axis 3   (slow axis in XZ and YZ scans)

    Photon counting
    ───────────────
        Implement _arm_photon_counter / _read_photon_counts / _stop_photon_counter
        (see the PHOTON COUNTING section at the bottom of this class).

    Scan data shape convention (matches Qudi ScanData)
    ───────────────────────────────────────────────────
        1D: data.shape == (n_fast,)
        2D: data.shape == (n_fast, n_slow)
            data[i_fast, i_slow] = count rate at (fast_pos[i_fast], slow_pos[i_slow])
    """

    # ── Configuration options ──────────────────────────────────────────────────
    _dll_path     = ConfigOption(
        'dll_path', mandatory=True,
        comment='Absolute path to E7XX_GCS_DLL_x64.dll')
    _gpib_board   = ConfigOption(
        'gpib_board', default=0,
        comment='NI-GPIB board number (0 = first installed board)')
    _gpib_address = ConfigOption(
        'gpib_address', default=4,
        comment='GPIB device address of the PI E-710 controller')
    _x_range      = ConfigOption(
        'x_range', default=[0.0, 100.0],
        comment='X travel range [min, max] in µm. '
                'Automatically replaced by hardware-reported limits on activation.')
    _y_range      = ConfigOption(
        'y_range', default=[0.0, 100.0],
        comment='Y travel range [min, max] in µm.')
    _z_range      = ConfigOption(
        'z_range', default=[0.0, 50.0],
        comment='Z travel range [min, max] in µm.')
    _trigger_mode = ConfigOption(
        'trigger_mode', default='SPCM',
        comment="PI trigger polarity: "
                "'SPCM' → active-low short pulse (1KT-1), "
                "'APD'  → active-high long  pulse (1KT2). "
                "Note: scan_xz / scan_yz hard-code SPCM regardless of this setting.")

    # ══════════════════════════════════════════════════════════════════════════
    # Lifecycle
    # ══════════════════════════════════════════════════════════════════════════

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

        # PI controller wrapper instance
        self._ctrl: Optional[PIE710Controller] = None

        # Qudi interface state
        self._constraints:        Optional[ScanConstraints] = None
        self._scan_settings:      Optional[ScanSettings]    = None
        self._back_scan_settings: Optional[ScanSettings]    = None
        self._scan_data:          Optional[ScanData]        = None

        # Scan thread control
        self._is_scanning:    bool = False
        self._stop_requested: bool = False
        self._scan_thread:    Optional[threading.Thread] = None
        self._lock                  = threading.Lock()

        # Last commanded target position in µm, updated by move_* and scans
        self._target_pos: Dict[str, float] = {'x': 0.0, 'y': 0.0, 'z': 0.0}

    # ── on_activate ───────────────────────────────────────────────────────────

    def on_activate(self) -> None:
        """
        Open GPIB connection, run probe_firmware() (INI + SVO + limits),
        and build Qudi ScanConstraints.

        Raises PIE7XXError if the PI controller is unreachable.
        """
        try:
            self._ctrl = PIE710Controller(self._dll_path)

            conn_id = self._ctrl.connect_ni_gpib(
                board_number   = int(self._gpib_board),
                device_address = int(self._gpib_address),
            )
            self.log.info(f"PI E-710 connected (GPIB id={conn_id}).")

            # probe_firmware(): INI all axes + SVO per axis + qTMN/qTMX + qPOS
            info = self._ctrl.probe_firmware()
            self.log.info(f"Controller ID : {info.get('idn', '(unknown)')}")

            # Prefer travel limits reported by the hardware over yaml values
            if (info.get('travel_min') and info.get('travel_max')
                    and len(info['travel_min']) >= 3):
                self._x_range = [info['travel_min'][0], info['travel_max'][0]]
                self._y_range = [info['travel_min'][1], info['travel_max'][1]]
                self._z_range = [info['travel_min'][2], info['travel_max'][2]]
                self.log.info(
                    f"Hardware travel limits — "
                    f"X: {self._x_range}, "
                    f"Y: {self._y_range}, "
                    f"Z: {self._z_range}  (µm)"
                )

            # Snapshot current sensor positions as initial targets
            pos = self._ctrl.get_position("123")
            self._target_pos = {'x': pos[0], 'y': pos[1], 'z': pos[2]}
            self.log.info(
                f"Current position — "
                f"x={pos[0]:.3f}, y={pos[1]:.3f}, z={pos[2]:.3f} µm"
            )

            self._constraints = self._build_constraints()
            self.log.info("PI E-710 ScanningProbe ready.")

        except PIE7XXError as exc:
            self.log.exception(f"PI E-710 on_activate failed: {exc}")
            raise

    # ── on_deactivate ─────────────────────────────────────────────────────────

    def on_deactivate(self) -> None:
        """Stop any running scan, then close the GPIB connection."""
        if self._is_scanning:
            self.stop_scan()
            if self._scan_thread and self._scan_thread.is_alive():
                self._scan_thread.join(timeout=15.0)

        if self._ctrl is not None:
            try:
                self._ctrl.close_connection()
            except Exception as exc:
                self.log.warning(f"PI E-710 close_connection: {exc}")
            self._ctrl = None

        self.log.info("PI E-710 ScanningProbe deactivated.")

    # ══════════════════════════════════════════════════════════════════════════
    # Constraints
    # ══════════════════════════════════════════════════════════════════════════

    def _build_constraints(self) -> ScanConstraints:
        """
        Build ScanConstraints from hardware travel limits.

        Channel naming
        ──────────────
        The default channel name is 'APD'.  If you have multiple detectors,
        add more ScannerChannel entries and update the data-filling logic in
        _store_1d_data / _store_2d_data accordingly.

        Frequency range
        ───────────────
        PI E-710 sample rate = 5 000 Hz.
        Maximum pixel frequency = 5 000 Hz  (1 waveform point per pixel).
        Minimum pixel frequency ≈ 1 Hz      (limited by waveform memory).
        """
        # ── Detector channels ──────────────────────────────────────────────
        # Add / rename to match your physical detector hardware.
        channel_objects = (
            ScannerChannel(name='APD', unit='c/s', dtype='float64'),
            # ScannerChannel(name='APD2', unit='c/s', dtype='float64'),
        )

        # ── Scanner axes ───────────────────────────────────────────────────
        def _make_axis(name: str, lo: float, hi: float) -> ScannerAxis:
            span = float(hi - lo)
            return ScannerAxis(
                name=name,
                unit='µm',
                position=ScalarConstraint(
                    default=round((lo + hi) / 2.0, 3),
                    bounds=(float(lo), float(hi)),
                ),
                step=ScalarConstraint(
                    default=0.1,
                    bounds=(1e-3, span),
                ),
                resolution=ScalarConstraint(
                    default=100,
                    bounds=(2, 2000),
                    enforce_int=True,
                ),
                frequency=ScalarConstraint(
                    default=1000.0,     # 1 ms per pixel — typical confocal
                    bounds=(1.0, 5000.0),
                ),
            )

        axis_objects = (
            _make_axis('x', *self._x_range),
            _make_axis('y', *self._y_range),
            _make_axis('z', *self._z_range),
        )

        return ScanConstraints(
            channel_objects=channel_objects,
            axis_objects=axis_objects,
            # The PI performs forward + backward sweeps, but only the forward
            # sweep has trigger gating.  Back-scan data acquisition is NOT
            # available with the current segment protocol.
            back_scan_capability=BackScanCapability(0),
            # The E-710 has built-in capacitive position sensors.
            # NB: live position recording per pixel (via DRC) is not
            # implemented here; set to False if you prefer to hide this.
            has_position_feedback=True,
            square_px_only=False,
        )

    @property
    def constraints(self) -> ScanConstraints:
        """Read-only hardware constraints."""
        return self._constraints

    # ══════════════════════════════════════════════════════════════════════════
    # Scan-settings properties  (read-only)
    # ══════════════════════════════════════════════════════════════════════════

    @property
    def scan_settings(self) -> Optional[ScanSettings]:
        """Currently configured scan settings, or None."""
        return self._scan_settings

    @property
    def back_scan_settings(self) -> Optional[ScanSettings]:
        """Always None — back scan is not supported on the PI E-710."""
        return None

    # ══════════════════════════════════════════════════════════════════════════
    # Reset
    # ══════════════════════════════════════════════════════════════════════════

    def reset(self) -> None:
        """
        Hard-reset: re-run probe_firmware() (INI all axes + SVO per axis).
        Any running scan is aborted first.
        """
        with self._lock:
            if self._is_scanning:
                self._stop_requested = True
                self._halt_generators()
            try:
                self._ctrl.probe_firmware()
                self.log.info("PI E-710 reset complete.")
            except PIE7XXError as exc:
                self.log.error(f"PI E-710 reset error: {exc}")

    # ══════════════════════════════════════════════════════════════════════════
    # Configure
    # ══════════════════════════════════════════════════════════════════════════

    def configure_scan(self, settings: ScanSettings) -> None:
        """
        Validate and store scan parameters.

        Supported axis combinations
        ───────────────────────────
            1D :  ('x',)   ('y',)   ('z',)
            2D :  ('x','y')   ('x','z')   ('y','z')
                  The first element is always the FAST axis.

        @param ScanSettings settings: complete scan configuration.
        @raises ValueError: settings violate constraints or axis combo unsupported.
        """
        with self._lock:
            if self._is_scanning:
                self.log.error("Cannot configure scan while scanning is in progress.")
                return

            # Validate against hardware constraints (range, resolution, frequency)
            self._constraints.check_settings(settings)

            _supported_axes = {
                ('x',), ('y',), ('z',),
                ('x', 'y'), ('x', 'z'), ('y', 'z'),
            }
            if tuple(settings.axes) not in _supported_axes:
                raise ValueError(
                    f"Axis combination {settings.axes} is not supported by "
                    f"the PI E-710 scan methods. "
                    f"Supported combinations: {_supported_axes}"
                )

            self._scan_settings      = settings
            self._back_scan_settings = None   # back scan always reset
            self._scan_data          = None

            self.log.debug(
                f"Scan configured — axes={settings.axes}, "
                f"range={settings.range}, resolution={settings.resolution}, "
                f"freq={settings.frequency:.1f} Hz "
                f"({1.0 / settings.frequency * 1e3:.2f} ms/px)"
            )

    def configure_back_scan(self, settings: ScanSettings) -> None:
        """
        Not supported.

        The PI E-710 generates TTL triggers only during the forward sweep.
        Reverse-sweep photon data is not available with the current
        segment / trigger protocol.

        @raises ValueError: always.
        """
        raise ValueError(
            "PI E-710 ScanningProbe does not support back-scan data acquisition. "
            "The PI hardware sweeps forward then backward autonomously, but "
            "the photon trigger gate is only active during the forward sweep."
        )

    # ══════════════════════════════════════════════════════════════════════════
    # Motion
    # ══════════════════════════════════════════════════════════════════════════

    def move_absolute(
        self,
        position: Dict[str, float],
        velocity: Optional[float] = None,
        blocking: bool = False,
    ) -> Dict[str, float]:
        """
        Move to an absolute position.

        @param position: dict with any subset of keys 'x', 'y', 'z'  (µm).
                         Omitted axes remain at their current targets.
        @param velocity: ignored — PI moves at maximum PID-controlled velocity.
        @param blocking: if True, wait until all requested axes are on-target.
        @return:         full target position dict for all three axes.
        """
        if self._is_scanning:
            self.log.error("Cannot move while a scan is in progress.")
            return self.get_target()

        with self._lock:
            try:
                # Merge requested positions into current target
                target = dict(self._target_pos)
                for ax, val in position.items():
                    if ax in ('x', 'y', 'z'):
                        target[ax] = float(val)

                # Clip each axis to its travel limits
                target['x'] = float(np.clip(target['x'], *self._x_range))
                target['y'] = float(np.clip(target['y'], *self._y_range))
                target['z'] = float(np.clip(target['z'], *self._z_range))

                # Issue MOV command (DLL call is non-blocking)
                self._ctrl.move_absolute(
                    ['1', '2', '3'],
                    [target['x'], target['y'], target['z']],
                )
                self._target_pos = target

                if blocking:
                    self._ctrl.wait_for_motion("123", timeout=60.0)

                return dict(self._target_pos)

            except PIE7XXError as exc:
                self.log.error(f"PI move_absolute error: {exc}")
                return self.get_target()

    def move_relative(
        self,
        distance: Dict[str, float],
        velocity: Optional[float] = None,
        blocking: bool = False,
    ) -> Dict[str, float]:
        """
        Move by a relative distance from the current target.

        @param distance: dict with any subset of keys 'x', 'y', 'z'  (µm).
        @param velocity: ignored.
        @param blocking: wait for motion to complete.
        @return:         full target position dict for all three axes.
        """
        if self._is_scanning:
            self.log.error("Cannot move while a scan is in progress.")
            return self.get_target()

        current = self.get_target()
        new_pos  = {ax: current[ax] + distance.get(ax, 0.0)
                    for ax in ('x', 'y', 'z')}
        return self.move_absolute(new_pos, velocity=velocity, blocking=blocking)

    def get_target(self) -> Dict[str, float]:
        """Return the last commanded target position (µm)."""
        return dict(self._target_pos)

    def get_position(self) -> Dict[str, float]:
        """
        Query actual position from the PI E-710's capacitive position sensors (µm).

        Falls back to the last target position if the hardware query fails
        (e.g. during an active waveform scan when sensor readout is unreliable).
        """
        if self._ctrl is None or not self._ctrl.connected:
            return dict(self._target_pos)
        try:
            pos = self._ctrl.get_position("123")
            return {'x': pos[0], 'y': pos[1], 'z': pos[2]}
        except PIE7XXError as exc:
            self.log.warning(f"PI get_position failed, returning target: {exc}")
            return dict(self._target_pos)

    # ══════════════════════════════════════════════════════════════════════════
    # Scanning
    # ══════════════════════════════════════════════════════════════════════════

    def start_scan(self) -> None:
        """
        Start the scan configured by configure_scan().

        Launches a background thread (_scan_worker) that:
            1. Arms the photon counter  →  _arm_photon_counter()
            2. Sends PI waveform / scan commands  →  PIE710Controller.scan_*()
            3. Polls E7XX_IsGeneratorRunning until the PI finishes
            4. Reads photon counts  →  _read_photon_counts()
            5. Stores results in self._scan_data (shape matches resolution)

        The ScanData object is initialised with NaN arrays immediately so
        Qudi can display a live (empty) image while waiting.
        """
        with self._lock:
            if self._is_scanning:
                self.log.error("Scan already running — call stop_scan() first.")
                return
            if self._scan_settings is None:
                self.log.error("No scan configured — call configure_scan() first.")
                return

            # Initialise ScanData with NaN-filled arrays right away
            self._scan_data = ScanData.from_constraints(
                settings=self._scan_settings,
                constraints=self._constraints,
                scanner_target_at_start=self.get_target(),
            )
            self._scan_data.new_scan()

            self._is_scanning    = True
            self._stop_requested = False

            self._scan_thread = threading.Thread(
                target=self._scan_worker,
                name='PIE710ScanWorker',
                daemon=True,
            )
            self._scan_thread.start()

    def stop_scan(self) -> None:
        """Interrupt a running scan."""
        if not self._is_scanning:
            self.log.warning("stop_scan() called but no scan is running.")
            return

        self._stop_requested = True
        self._halt_generators()
        self._stop_photon_counter()
        self._is_scanning = False

        if self._scan_thread and self._scan_thread.is_alive():
            self._scan_thread.join(timeout=10.0)

        self.log.info("PI E-710 scan stopped.")

    def get_scan_data(self) -> Optional[ScanData]:
        """Return the current or most recently completed ScanData object."""
        return self._scan_data

    def get_back_scan_data(self) -> Optional[ScanData]:
        """Not available on PI E-710 — always returns None."""
        return None

    def emergency_stop(self) -> None:
        """Immediately halt all axes (HLT) and stop all waveform generators."""
        self._stop_requested = True
        try:
            self._ctrl.halt("123")
        except PIE7XXError:
            pass
        self._halt_generators()
        self._stop_photon_counter()
        self._is_scanning = False
        self.log.warning("PI E-710: EMERGENCY STOP executed.")

    # ══════════════════════════════════════════════════════════════════════════
    # Internal scan orchestration
    # ══════════════════════════════════════════════════════════════════════════

    def _scan_worker(self) -> None:
        """
        Background thread entry point.

        Dispatches to _run_1d_scan or _run_2d_scan based on the number of
        configured axes.  Sets _is_scanning = False in its finally block.
        """
        try:
            s       = self._scan_settings
            t_pixel = 1.0 / s.frequency          # seconds per pixel

            if len(s.axes) == 1:
                self._run_1d_scan(
                    axis       = s.axes[0],
                    scan_range = s.range[0],
                    n_pts      = s.resolution[0],
                    t_pixel    = t_pixel,
                )
            elif len(s.axes) == 2:
                self._run_2d_scan(
                    fast_axis  = s.axes[0],
                    slow_axis  = s.axes[1],
                    fast_range = s.range[0],
                    slow_range = s.range[1],
                    n_fast     = s.resolution[0],
                    n_slow     = s.resolution[1],
                    t_pixel    = t_pixel,
                )
            else:
                self.log.error(f"Unsupported scan dimension: {len(s.axes)}")
        except Exception as exc:
            self.log.exception(f"Scan worker unhandled exception: {exc}")
        finally:
            self._is_scanning = False

    # ── 1D scan ───────────────────────────────────────────────────────────────

    def _run_1d_scan(
        self,
        axis:       str,
        scan_range: Tuple[float, float],
        n_pts:      int,
        t_pixel:    float,
    ) -> None:
        """
        Arm counter → send PI 1D scan command → wait → read counts → store.

        scan_x / scan_y / scan_z in PIE710Controller:
          - Move to start position (with 0.5 s settle)
          - Set up one forward + one backward waveform segment
          - Enable trigger on forward segment only
          - Send '1SC0,WA{wait_ms}'  ← non-blocking from PC side
        """
        pos_array = np.linspace(scan_range[0], scan_range[1], n_pts).tolist()
        cur       = self.get_target()

        # ── 1. Arm photon counter ─────────────────────────────────────────
        self._arm_photon_counter(n_pixels=n_pts, t_pixel=t_pixel)

        if self._stop_requested:
            return

        # ── 2. Send PI scan command ───────────────────────────────────────
        try:
            if axis == 'x':
                self._ctrl.scan_x(
                    x=pos_array, y=cur['y'], z=cur['z'],
                    t_pixel=t_pixel, trigger=self._trigger_mode,
                )
            elif axis == 'y':
                self._ctrl.scan_y(
                    x=cur['x'], y=pos_array, z=cur['z'],
                    t_pixel=t_pixel, trigger=self._trigger_mode,
                )
            elif axis == 'z':
                self._ctrl.scan_z(
                    x=cur['x'], y=cur['y'], z=pos_array,
                    t_pixel=t_pixel, trigger=self._trigger_mode,
                )
            else:
                self.log.error(f"Unknown axis '{axis}'.")
                self._stop_photon_counter()
                return
        except PIE7XXError as exc:
            self.log.error(f"PI 1D scan command error: {exc}")
            self._stop_photon_counter()
            return

        # ── 3. Wait for PI to finish ──────────────────────────────────────
        # scan_x/y/z use speed_pts=100 → overhead = 2*100/5000 = 0.04 s
        overhead_s  = 2.0 * 100 / PIE710Controller.SAMP_RATE
        estimated_s = 2.0 * n_pts * t_pixel + overhead_s + 1.5
        self._wait_for_scan_complete(estimated_s=estimated_s)

        if self._stop_requested:
            self._stop_photon_counter()
            return

        # ── 4. Collect counts ─────────────────────────────────────────────
        counts = self._read_photon_counts(n_pixels=n_pts)
        self._store_1d_data(
            counts   = counts,
            axis     = axis,
            axis_end = pos_array[-1],
            t_pixel  = t_pixel,
            n_pts    = n_pts,
        )

    # ── 2D scan ───────────────────────────────────────────────────────────────

    def _run_2d_scan(
        self,
        fast_axis:  str,
        slow_axis:  str,
        fast_range: Tuple[float, float],
        slow_range: Tuple[float, float],
        n_fast:     int,
        n_slow:     int,
        t_pixel:    float,
    ) -> None:
        """
        Arm counter → send PI 2D scan command → wait → read counts → store.

        scan_xy: '0SC32,WA{wait_ms},RP{ny}'  ← runs ny lines, non-blocking
        scan_xz: '0SC32,WA1000,RP{nz}'       ← WA hardcoded, non-blocking
        scan_yz: '0SC32,WA1000,RP{nz}'       ← WA hardcoded, non-blocking
        """
        fast_pos = np.linspace(fast_range[0], fast_range[1], n_fast).tolist()
        slow_pos = np.linspace(slow_range[0], slow_range[1], n_slow).tolist()
        cur      = self.get_target()
        n_total  = n_fast * n_slow

        # ── 1. Arm photon counter ─────────────────────────────────────────
        self._arm_photon_counter(n_pixels=n_total, t_pixel=t_pixel)

        if self._stop_requested:
            return

        # ── 2. Send PI scan command ───────────────────────────────────────
        try:
            if fast_axis == 'x' and slow_axis == 'y':
                self._ctrl.scan_xy(
                    x=fast_pos, y=slow_pos, z=cur['z'],
                    t_pixel=t_pixel, trigger=self._trigger_mode,
                )
            elif fast_axis == 'x' and slow_axis == 'z':
                # scan_xz: trigger mode hard-coded to SPCM (1KT-1) in controller
                self.log.debug(
                    "scan_xz: trigger mode is hard-coded to SPCM (active-low) "
                    "in PIE710Controller — 'trigger_mode' config option has no effect here."
                )
                self._ctrl.scan_xz(
                    x=fast_pos, y=cur['y'], z=slow_pos,
                    t_pixel=t_pixel,
                )
            elif fast_axis == 'y' and slow_axis == 'z':
                # scan_yz: trigger mode hard-coded to SPCM (1KT-1) in controller
                self.log.debug(
                    "scan_yz: trigger mode is hard-coded to SPCM (active-low) "
                    "in PIE710Controller — 'trigger_mode' config option has no effect here."
                )
                self._ctrl.scan_yz(
                    x=cur['x'], y=fast_pos, z=slow_pos,
                    t_pixel=t_pixel,
                )
            else:
                self.log.error(
                    f"Unsupported 2D axis combination: "
                    f"fast='{fast_axis}', slow='{slow_axis}'. "
                    f"Supported: (x,y), (x,z), (y,z)."
                )
                self._stop_photon_counter()
                return
        except PIE7XXError as exc:
            self.log.error(f"PI 2D scan command error: {exc}")
            self._stop_photon_counter()
            return

        # ── 3. Wait for PI to finish ──────────────────────────────────────
        # For scan_xy: each line takes 2*(n_fast*n + 2*speed_pts)/5000 seconds
        #   where n = round(t_pixel * 5000), speed_pts = 50.
        # For scan_xz / scan_yz: WA is hard-coded to 1000 ms per line.
        if slow_axis == 'y':
            # Match scan_xy calculation: speed_pts=50
            speed_pts   = 50
            n_per_pixel = max(1, round(t_pixel * PIE710Controller.SAMP_RATE))
            total_pts   = n_fast * n_per_pixel + 2 * speed_pts
            wait_s_line = 2.0 * total_pts / PIE710Controller.SAMP_RATE + 0.1
        else:
            # scan_xz / scan_yz: WA1000 hard-coded
            wait_s_line = 1.0 + 0.2   # 1 s wait + settle margin
        estimated_s = n_slow * wait_s_line + 5.0

        self._wait_for_scan_complete(estimated_s=estimated_s)

        if self._stop_requested:
            self._stop_photon_counter()
            return

        # ── 4. Collect counts ─────────────────────────────────────────────
        counts = self._read_photon_counts(n_pixels=n_total)
        self._store_2d_data(
            counts    = counts,
            fast_axis = fast_axis, slow_axis = slow_axis,
            fast_end  = fast_pos[-1], slow_end = slow_pos[-1],
            t_pixel   = t_pixel, n_fast = n_fast, n_slow = n_slow,
        )

    # ══════════════════════════════════════════════════════════════════════════
    # Data storage helpers
    # ══════════════════════════════════════════════════════════════════════════

    def _store_1d_data(
        self,
        counts:   Optional[np.ndarray],
        axis:     str,
        axis_end: float,
        t_pixel:  float,
        n_pts:    int,
    ) -> None:
        """
        Convert raw counts → counts/s, write into self._scan_data.

        The first channel in settings.channels receives the counter data.
        Any additional channels (e.g. second detector) receive zeros;
        update this logic when you add a second counting channel.
        """
        if self._scan_data is None or self._scan_settings is None:
            return

        channels = self._scan_settings.channels

        if counts is not None and len(counts) == n_pts:
            rate_1d = np.asarray(counts, dtype=float) / t_pixel   # → c/s
            data_dict: Dict[str, np.ndarray] = {}
            for idx, ch in enumerate(channels):
                # Channel 0 → counter data; remaining channels → zeros
                data_dict[ch] = rate_1d if idx == 0 else np.zeros(n_pts, dtype=float)
            try:
                self._scan_data.data = data_dict
            except ValueError as exc:
                self.log.error(f"ScanData 1D assignment failed: {exc}")
        else:
            self.log.warning(
                f"1D count array has wrong size: "
                f"got {len(counts) if counts is not None else 'None'}, "
                f"expected {n_pts}. Scan data will remain NaN."
            )

        # Track where the stage ended up
        self._target_pos[axis] = axis_end

    def _store_2d_data(
        self,
        counts:    Optional[np.ndarray],
        fast_axis: str,
        slow_axis: str,
        fast_end:  float,
        slow_end:  float,
        t_pixel:   float,
        n_fast:    int,
        n_slow:    int,
    ) -> None:
        """
        Reshape, transpose, and convert 2D count data, then write into _scan_data.

        Counter delivers data in row-major (line-major) order:
            [line_0_px_0,  line_0_px_1,  ..., line_0_px_(n_fast-1),
             line_1_px_0,  ...,
             line_(n_slow-1)_px_(n_fast-1)]

        Qudi ScanData expects shape (n_fast, n_slow):
            data[i_fast, i_slow] = count at (fast_pos[i_fast], slow_pos[i_slow])

        Therefore: reshape → (n_slow, n_fast) → transpose → (n_fast, n_slow).
        """
        if self._scan_data is None or self._scan_settings is None:
            return

        channels   = self._scan_settings.channels
        resolution = (n_fast, n_slow)
        n_total    = n_fast * n_slow

        if counts is not None and len(counts) == n_total:
            rate_2d = (
                np.asarray(counts, dtype=float)
                .reshape(n_slow, n_fast)   # row = slow-axis step
                .T                          # → (n_fast, n_slow)
                / t_pixel                   # raw counts → counts/s
            )
            # rate_2d.shape == (n_fast, n_slow) == resolution  ✓

            data_dict: Dict[str, np.ndarray] = {}
            for idx, ch in enumerate(channels):
                data_dict[ch] = (rate_2d if idx == 0
                                 else np.zeros(resolution, dtype=float))
            try:
                self._scan_data.data = data_dict
            except ValueError as exc:
                self.log.error(f"ScanData 2D assignment failed: {exc}")
        else:
            self.log.warning(
                f"2D count array has wrong size: "
                f"got {len(counts) if counts is not None else 'None'}, "
                f"expected {n_total}. Scan data will remain NaN."
            )

        self._target_pos[fast_axis] = fast_end
        self._target_pos[slow_axis] = slow_end

    # ══════════════════════════════════════════════════════════════════════════
    # Wait / control helpers
    # ══════════════════════════════════════════════════════════════════════════

    def _wait_for_scan_complete(
        self,
        estimated_s:   float = 30.0,
        poll_interval: float = 0.25,
    ) -> None:
        """
        Block until both PI waveform generators become idle.

        Strategy
        ────────
        Phase 1 — coarse sleep:
            Sleep ~80 % of *estimated_s* in small chunks (checking
            _stop_requested each chunk) to avoid GPIB polling overhead
            during the bulk of the scan.

        Phase 2 — precise polling:
            Call E7XX_IsGeneratorRunning(id, b'12', buf) every
            *poll_interval* seconds until both generators report idle (0).

        Fallback:
            If the DLL call fails for any reason, sleep the remaining time.

        @param estimated_s:    Expected scan duration in seconds.
        @param poll_interval:  Polling period in seconds (phase 2).
        """
        coarse_s = max(0.0, estimated_s * 0.80 - poll_interval)
        deadline = time.monotonic() + estimated_s * 3.0 + 10.0

        # ── Phase 1: coarse sleep in 100 ms chunks ────────────────────────
        elapsed = 0.0
        chunk   = 0.1
        while elapsed < coarse_s:
            if self._stop_requested:
                return
            time.sleep(chunk)
            elapsed += chunk

        # ── Phase 2: poll IsGeneratorRunning ─────────────────────────────
        try:
            while time.monotonic() < deadline:
                if self._stop_requested:
                    return
                buf = (ctypes.c_int * 2)()
                ret = self._ctrl._dll.E7XX_IsGeneratorRunning(
                    self._ctrl._id,
                    b'12',   # query generators 1 and 2
                    buf,
                )
                # ret = 1 (success), buf[0/1] = 1 (running) or 0 (idle)
                if ret and buf[0] == 0 and buf[1] == 0:
                    return   # both generators idle — scan complete
                time.sleep(poll_interval)
            self.log.warning("Scan completion timeout exceeded.")
        except Exception as exc:
            self.log.warning(
                f"E7XX_IsGeneratorRunning poll failed ({exc}); "
                f"using time-based fallback."
            )
            remaining = max(0.0, estimated_s - elapsed)
            time.sleep(remaining)

    def _halt_generators(self) -> None:
        """Send '0SC0' to stop all PI waveform generators immediately."""
        try:
            self._ctrl.send_raw_string('0SC0')
        except Exception as exc:
            self.log.warning(f"PI halt generators: {exc}")

