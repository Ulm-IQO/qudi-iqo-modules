    def _read_photon_counts(self, n_pixels: int) -> Optional[np.ndarray]:
        """
        Read *n_pixels* raw photon-count values from the counter hardware.

        Called **after** `_wait_for_scan_complete()` confirms the PI is idle.

        Returns
        -------
        np.ndarray, shape (n_pixels,)
            Raw photon counts (integers).  Conversion to counts/s is
            applied by _store_1d_data / _store_2d_data.
        None
            If the counter is not connected or the read fails.

        Data ordering for 2D scans
        ──────────────────────────
        The array must be in row-major (line-major) order:
            index k  =  i_slow * n_fast + i_fast
        i.e.   [line_0_px_0, line_0_px_1, ..., line_0_px_(n_fast-1),
                line_1_px_0, ...,
                line_(n_slow-1)_px_(n_fast-1)]

        ════════════════════════════════════════════════════════════════════
         NI-DAQ EXAMPLE
        ════════════════════════════════════════════════════════════════════
